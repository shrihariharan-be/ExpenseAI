# ExpenseAI Environment Configuration Template
# Copy this file to .env and configure values securely for local development.
# In production (Render), configure these via the Render Dashboard environment variables.

FLASK_ENV=production
SECRET_KEY=your-secure-random-secret-key-here
PORT=5000
PYTHON_VERSION=3.11.11

# Administrator Credentials (sync: false in render.yaml)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@expenseai.com
ADMIN_PASSWORD=YourStrongAdminPasswordHere123!

# Session Security (set to true when served over HTTPS)
SESSION_COOKIE_SECURE=false
